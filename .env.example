# Required for service access; not needed for config:preview
LOTTO_USER_ID=your_id
LOTTO_USER_PASSWORD=your_password

# Runtime target only. Counts and manual/auto games come from config/report.json.
LOTTO_BUY_MODE=LOTTO_ONLY
PURCHASE_CONFIG_PATH=config/report.json

# Playwright options
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_STORAGE_STATE_PATH=.auth/storage-state.json

# Weekly check target (for `pnpm run check:weekly`)
# lotto365 | pension
# legacy aliases: LO40 | LP72
# Comment out CHECK_TARGET when the JSON file/profile should select the target.
CHECK_TARGET=lotto365

# Optional: override weekly check date range (YYYYMMDD)
# CHECK_FROM_YMD=20260208
# CHECK_TO_YMD=20260214

# Optional report configuration (JSON). Explicit report env settings above
# override defaults and profiles in the file. Remove them to use file values.
# CHECK_CONFIG_PATH=config/report.example.json
# CHECK_PROFILE=weekly
# CHECK_RESULT_PATH=./report-result.json
# Offline preview without login: pnpm run config:preview
